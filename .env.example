# =============================================================
# InsureCompare.at - environment configuration (example)
# Copy to .env and fill in real values for your environment.
# =============================================================

# ---- Postgres ----
POSTGRES_DB=insurecompare
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_to_something_long_and_random
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Composed at runtime by docker compose; override only if connecting from outside.
DATABASE_URL=postgresql+asyncpg://app:change_me_to_something_long_and_random@db:5432/insurecompare

# ---- Backend ----
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://localhost,https://app.insurecompare.local
ENVIRONMENT=development
LOG_LEVEL=INFO

# 32+ random bytes; can be generated with: openssl rand -hex 32
JWT_SECRET=replace_with_32_byte_hex_secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760           # 10 MB

# ---- NLP / OCR ----
SPACY_MODEL=de_core_news_lg
GBERT_MODEL=Sahajtomar/German_Zeroshot
OCR_LANGUAGE=deu
OCR_CONFIDENCE_THRESHOLD=70
# Only needed on native Windows dev installs where tesseract isn't on PATH
# (leave unset in Docker; tesseract-ocr is already on PATH in the image):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- AI Policy Advisor (LLM) ----
# "gemini" for the real Google Gemini API, "mock" for a deterministic
# offline provider (used automatically by tests/CI). Leave as "mock" until
# you have a real key — the app runs fully without Gemini configured.
LLM_PROVIDER=mock
# Never commit a real key here. Put it only in your local backend/.env,
# which is gitignored. Get a key at https://ai.google.dev/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Frontend ----
VITE_API_BASE_URL=/api
VITE_APP_NAME=InsureCompare.at

# ---- Demo seed accounts (development only) ----
SEED_DEMO_USER_EMAIL=user@test.at
SEED_DEMO_USER_PASSWORD=user123
SEED_DEMO_ADMIN_EMAIL=admin@insurance.at
SEED_DEMO_ADMIN_PASSWORD=admin123
